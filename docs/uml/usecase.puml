@startuml
title Colors Web Application - Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor "User" as user
actor "MySQL Database\n(COP4331)" as db <<secondary>>

rectangle "Colors Web Application" {
  usecase "Log In" as UC1
  usecase "Add Color" as UC2
  usecase "Search Colors" as UC3
  usecase "Log Out" as UC4
  usecase "Verify Login Cookie" as UC5
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4

' color.html runs readCookie() on load; without a valid cookie the user is sent back to index.html
UC2 ..> UC5 : <<include>>
UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>

' Log Out only clears the browser cookie, so it never touches the database
UC1 -- db : SELECT Users
UC2 -- db : INSERT Colors
UC3 -- db : SELECT Colors

note bottom of UC1
  Not implemented: registration, delete,
  contacts. Accounts are inserted directly in MySQL.
end note
@enduml
